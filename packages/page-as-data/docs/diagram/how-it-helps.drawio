        </mxCell>
        <mxCell id="flowsN0" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1;fontColor=#FFFFFF;fontStyle=1;fontFamily=Segoe UI;fontSize=9;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="93.0" width="14" height="14" as="geometry" />
        </mxCell>
        <mxCell id="flowsT0" value="You (or an AI agent, or CI) run  page-as-data read &lt;url&gt;  or  check &lt;url&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=10;fontColor=#323130;align=left;verticalAlign=middle;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="48" y="92" width="536" height="16" as="geometry" />
        </mxCell>
        <mxCell id="flowsN1" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1;fontColor=#FFFFFF;fontStyle=1;fontFamily=Segoe UI;fontSize=9;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="109.0" width="14" height="14" as="geometry" />
        </mxCell>
        <mxCell id="flowsT1" value="The CLI opens a tab and injects page-as-data.js before the app's own scripts" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=10;fontColor=#323130;align=left;verticalAlign=middle;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="48" y="108" width="536" height="16" as="geometry" />
        </mxCell>
        <mxCell id="flowsN2" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1;fontColor=#FFFFFF;fontStyle=1;fontFamily=Segoe UI;fontSize=9;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="125.0" width="14" height="14" as="geometry" />
        </mxCell>
        <mxCell id="flowsT2" value="The script waits until the screen has really finished, then reads it" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=10;fontColor=#323130;align=left;verticalAlign=middle;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="48" y="124" width="536" height="16" as="geometry" />
        </mxCell>
        <mxCell id="flowsN3" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1;fontColor=#FFFFFF;fontStyle=1;fontFamily=Segoe UI;fontSize=9;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="141.0" width="14" height="14" as="geometry" />
        </mxCell>
        <mxCell id="flowsT3" value="Chrome reports what broke behind the page: exceptions, console, requests" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=10;fontColor=#323130;align=left;verticalAlign=middle;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="48" y="140" width="536" height="16" as="geometry" />
        </mxCell>
        <mxCell id="flowsN4" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1;fontColor=#FFFFFF;fontStyle=1;fontFamily=Segoe UI;fontSize=9;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="157.0" width="14" height="14" as="geometry" />
        </mxCell>
        <mxCell id="flowsT4" value="You get the screen as text or JSON, with exit code 1 when something is wrong" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=10;fontColor=#323130;align=left;verticalAlign=middle;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="48" y="156" width="536" height="16" as="geometry" />
        </mxCell>
        <mxCell id="flowsN5" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1;fontColor=#FFFFFF;fontStyle=1;fontFamily=Segoe UI;fontSize=9;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="173.0" width="14" height="14" as="geometry" />
        </mxCell>
        <mxCell id="flowsT5" value="Fix, run again. A screenshot only for what data cannot answer" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=10;fontColor=#323130;align=left;verticalAlign=middle;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="48" y="172" width="536" height="16" as="geometry" />
        </mxCell>
        <mxCell id="missesText" value="&lt;font color=&quot;#A4262C&quot;&gt;▲&lt;/font&gt; A button cut off by its container just looks absent&lt;br&gt;&lt;font color=&quot;#A4262C&quot;&gt;▲&lt;/font&gt; A hidden element looks the same as one that does not exist&lt;br&gt;&lt;font color=&quot;#A4262C&quot;&gt;▲&lt;/font&gt; Console errors, uncaught exceptions and failed requests are invisible&lt;br&gt;&lt;font color=&quot;#A4262C&quot;&gt;▲&lt;/font&gt; Colour and contrast are guessed from compressed pixels&lt;br&gt;&lt;font color=&quot;#A4262C&quot;&gt;▲&lt;/font&gt; A background tab shows a half-loaded page, which reads as a bug&lt;br&gt;&lt;font color=&quot;#A4262C&quot;&gt;▲&lt;/font&gt; Every look costs a large image in an AI agent's context" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=10;fontColor=#323130;align=left;verticalAlign=top;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="600" y="86" width="542" height="102" as="geometry" />
        </mxCell>
        <mxCell id="legend0t" value="You run a command" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=10;fontColor=#323130;align=left;verticalAlign=middle;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="63" y="336" width="147" height="16" as="geometry" />
        </mxCell>
        <mxCell id="legend1t" value="Injected over DevTools Protocol" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=10;fontColor=#323130;align=left;verticalAlign=middle;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="63" y="351" width="147" height="16" as="geometry" />
        </mxCell>
        <mxCell id="legend2t" value="Reads the rendered page" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=10;fontColor=#323130;align=left;verticalAlign=middle;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="63" y="366" width="147" height="16" as="geometry" />
        </mxCell>
        <mxCell id="legend3t" value="Browser events (errors, requests)" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=10;fontColor=#323130;align=left;verticalAlign=middle;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="63" y="381" width="147" height="16" as="geometry" />
        </mxCell>
        <mxCell id="legend4t" value="Answer as data" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=10;fontColor=#323130;align=left;verticalAlign=middle;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="63" y="396" width="147" height="16" as="geometry" />
        </mxCell>
        <mxCell id="legend5t" value="Last resort only" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=10;fontColor=#323130;align=left;verticalAlign=middle;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="63" y="411" width="147" height="16" as="geometry" />
        </mxCell>
        <mxCell id="inpageText" value="&lt;b&gt;settle&lt;/b&gt; — waits for router requests, React streams, skeletons, animations&lt;br&gt;&lt;b&gt;read&lt;/b&gt; — headings, text, dialogs, alerts, tables, form fields and their errors, buttons and their state&lt;br&gt;&lt;b&gt;inspect&lt;/b&gt; — visible? cut off by what? colour, contrast&lt;br&gt;&lt;b&gt;click / fill&lt;/b&gt; — reproduce the bug&lt;br&gt;&lt;b&gt;check&lt;/b&gt; — overflow, cut-off controls, broken sticky, WCAG touch targets" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=10;fontColor=#323130;align=left;verticalAlign=top;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="698" y="256" width="208" height="164" as="geometry" />
        </mxCell>
        <mxCell id="readPanelText" value="&lt;font color=&quot;#0078D4&quot;&gt;•&lt;/font&gt; Headings, main text, open dialogs&lt;br&gt;&lt;font color=&quot;#0078D4&quot;&gt;•&lt;/font&gt; Alerts and status messages&lt;br&gt;&lt;font color=&quot;#0078D4&quot;&gt;•&lt;/font&gt; Tables as rows, with links&lt;br&gt;&lt;font color=&quot;#0078D4&quot;&gt;•&lt;/font&gt; Form fields, values, validation errors&lt;br&gt;&lt;font color=&quot;#0078D4&quot;&gt;•&lt;/font&gt; Buttons and links, disabled or expanded" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=10;fontColor=#323130;align=left;verticalAlign=top;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="32" y="468" width="259" height="74" as="geometry" />
        </mxCell>
        <mxCell id="behindPanelText" value="&lt;font color=&quot;#CA5010&quot;&gt;•&lt;/font&gt; Uncaught exceptions&lt;br&gt;&lt;font color=&quot;#CA5010&quot;&gt;•&lt;/font&gt; console.error and warnings&lt;br&gt;&lt;font color=&quot;#CA5010&quot;&gt;•&lt;/font&gt; Failed requests (4xx, 5xx, network)&lt;br&gt;&lt;font color=&quot;#CA5010&quot;&gt;•&lt;/font&gt; Broken images&lt;br&gt;&lt;font color=&quot;#CA5010&quot;&gt;•&lt;/font&gt; Pages that never finish loading, and why" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=10;fontColor=#323130;align=left;verticalAlign=top;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="310" y="468" width="259" height="74" as="geometry" />
        </mxCell>
        <mxCell id="inspectPanelText" value="&lt;font color=&quot;#008575&quot;&gt;•&lt;/font&gt; Visible? Hidden by what? Cut off by what?&lt;br&gt;&lt;font color=&quot;#008575&quot;&gt;•&lt;/font&gt; Colour and WCAG contrast, incl. oklch and gradients&lt;br&gt;&lt;font color=&quot;#008575&quot;&gt;•&lt;/font&gt; Page wider than the phone screen&lt;br&gt;&lt;font color=&quot;#008575&quot;&gt;•&lt;/font&gt; Controls cut off where nothing scrolls to them&lt;br&gt;&lt;font color=&quot;#008575&quot;&gt;•&lt;/font&gt; Sticky headers that can never stick" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=10;fontColor=#323130;align=left;verticalAlign=top;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="588" y="468" width="279" height="74" as="geometry" />
        </mxCell>
        <mxCell id="foundText" value="&lt;font color=&quot;#A4262C&quot;&gt;▲&lt;/font&gt; 'New product' and 'New user' cut off at 390px&lt;br&gt;&lt;font color=&quot;#A4262C&quot;&gt;▲&lt;/font&gt; Table header 48px down, over the first row&lt;br&gt;&lt;font color=&quot;#A4262C&quot;&gt;▲&lt;/font&gt; Primary button text at 4.02:1 contrast&lt;br&gt;&lt;font color=&quot;#A4262C&quot;&gt;▲&lt;/font&gt; A page read as 'settled' before it switched" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=10;fontColor=#323130;align=left;verticalAlign=top;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="886" y="468" width="256" height="74" as="geometry" />
        </mxCell>
        <mxCell id="tryText" value="&lt;font face=&quot;Consolas&quot;&gt;npx page-as-data read http://localhost:3000/orders --width 390&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;what is on the orders screen on a phone, and what went wrong behind it&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot;&gt;npx page-as-data read …/orders --click &quot;New order&quot; --fill &quot;Email=a@b.co&quot;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;reproduce a bug step by step, then read the result&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot;&gt;npx page-as-data check …/ …/orders --widths 390,1440&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;CI gate: exit code 1 when a page has a defect&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=10;fontColor=#323130;align=left;verticalAlign=top;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="32" y="572" width="566" height="92" as="geometry" />
        </mxCell>
        <mxCell id="runsText" value="&lt;font color=&quot;#243A5E&quot;&gt;•&lt;/font&gt; Node 22 or newer, and Chrome, Chromium or Edge. Nothing else to install&lt;br&gt;&lt;font color=&quot;#243A5E&quot;&gt;•&lt;/font&gt; Pages behind a sign-in: start Chrome with --remote-debugging-port=9222, sign in once, pass --port 9222&lt;br&gt;&lt;font color=&quot;#243A5E&quot;&gt;•&lt;/font&gt; Public pages and CI: --launch starts its own headless Chrome&lt;br&gt;&lt;font color=&quot;#243A5E&quot;&gt;•&lt;/font&gt; Any framework. settle also knows React 19 streaming and the Next.js App Router&lt;br&gt;&lt;font color=&quot;#243A5E&quot;&gt;•&lt;/font&gt; From Playwright or Chrome DevTools MCP: inject page-as-data.js and call window.__pageAsData" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=10;fontColor=#323130;align=left;verticalAlign=top;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="620" y="570" width="522" height="94" as="geometry" />
