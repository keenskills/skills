        </mxCell>
        <mxCell id="designText" value="&lt;font color=&quot;#0078D4&quot;&gt;●&lt;/font&gt; Private endpoints for every data service; public access disabled&lt;br&gt;&lt;font color=&quot;#0078D4&quot;&gt;●&lt;/font&gt; Orders are commands on Service Bus; telemetry streams to Event Hubs&lt;br&gt;&lt;font color=&quot;#0078D4&quot;&gt;●&lt;/font&gt; Event Hubs Capture lands raw events in the Data Lake for Synapse&lt;br&gt;&lt;font color=&quot;#0078D4&quot;&gt;●&lt;/font&gt; AKS pods use workload identity; secrets live in Key Vault&lt;br&gt;&lt;font color=&quot;#0078D4&quot;&gt;●&lt;/font&gt; Zone-redundant AKS, Cosmos DB, SQL and Service Bus Premium&lt;br&gt;&lt;font color=&quot;#0078D4&quot;&gt;●&lt;/font&gt; Two WAF layers: Front Door at the edge, App Gateway in the VNet" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=10;fontColor=#323130;align=left;verticalAlign=top;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="616" y="80" width="526" height="114" as="geometry" />
