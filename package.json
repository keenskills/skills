{
  "name": "keenskills",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm test:repo && pnpm -r test",
    "test:repo": "node --test \"test/*.test.mjs\"",
    "test:diagrams": "pnpm --filter @keenskills/drawing-architecture-diagrams test",
    "test:docs": "pnpm --filter @keenskills/writing-design-documents test",
    "sync": "node scripts/sync-shared.mjs",
    "site:dev": "pnpm --filter @keenskills/site dev",
    "site:build": "pnpm --filter @keenskills/site build",
    "site:check": "pnpm --filter @keenskills/site build && pnpm --filter @keenskills/site test:pages && pnpm --filter @keenskills/site test:interactions && pnpm --filter @keenskills/site self-check"
  },
  "license": "MIT"
}
